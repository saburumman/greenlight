# Copy this file to .env and fill in real values before running
# `docker compose up` (or `npm start` locally). .env is gitignored — never
# commit real secrets.

PORT=3000

# ---- Atlassian login (required) --------------------------------------
# All 5 of these (through SESSION_SECRET below) must be set — the server
# refuses to start without them. There is no guest/no-login fallback mode.
#
# See README.md "Authentication (Sign in with Atlassian)" for the exact
# steps to register the OAuth app in the Atlassian Developer Console.

# Must exactly match the URL this container is actually reachable at,
# including https:// — it's used to build the OAuth callback URL
# (APP_BASE_URL + /auth/callback), which must be registered in the
# Atlassian Developer Console character-for-character.
APP_BASE_URL=https://release-monitor.yourcompany.com

# Your Jira Cloud site — only Atlassian accounts with access to this site
# are allowed to sign in.
JIRA_SITE_URL=https://yourcompany.atlassian.net

# From the OAuth 2.0 (3LO) app you create at
# https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# A long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# Changing this instantly signs everyone out (old cookies stop verifying).
SESSION_SECRET=

# ---- AI-assisted Release Notes (optional) -----------------------------
# Leave blank to skip AI entirely — Release Notes generation still works
# without it, using the same local rule-based summarizer it always has
# (extracts from the ticket's own description, never invents anything).
# Set this to also have Google Gemini write the human-readable
# title/description for each item; every factual field (key, type, status,
# priority, URL) still always comes straight from Jira, never from the AI.
# See README.md "Release Notes generation" for how this fits together.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — overrides the default model used for Release Notes summaries.
# The default below was requested directly rather than confirmed against
# Google's current model list — if it starts erroring with "model not
# found", check https://ai.google.dev/gemini-api/docs/models and put the
# current valid id here instead; no code change needed either way.
# GEMINI_MODEL=gemini-3.6-flash
